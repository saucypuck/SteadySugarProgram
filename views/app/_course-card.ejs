<%# Course card for the catalog / related rows. Expects a decorated `course`. %>
<a href="/app/courses/<%= course.slug %>" class="course-card2">
  <div class="thumb cat-<%= course.category %>">
    <span class="thumb-icon"><%= course.cat.icon %></span>
    <span class="thumb-dur"><%= course.lessons.length %> lessons · <%= course.totalMinutes %> min</span>
    <% if (course.state === 'locked') { %><span class="thumb-state">🔒 <%= course.needPlan.name %></span>
    <% } else if (course.state === 'preview') { %><span class="thumb-state free">Free preview</span>
    <% } else if (course.progress.pct === 100) { %><span class="thumb-state done">✓ Complete</span><% } %>
  </div>
  <div class="cc-body">
    <small class="cc-cat"><%= course.cat.name %><%= course.weeks ? ' · Weeks ' + course.weeks : '' %></small>
    <h3><%= course.title %></h3>
    <p class="small muted"><%= course.summary %></p>
    <div class="cc-foot">
      <% if (course.unlocked && course.progress.done) { %>
        <div class="progress"><span style="width:<%= course.progress.pct %>%"></span></div>
        <small class="muted"><%= course.progress.done %>/<%= course.progress.total %> complete</small>
      <% } else { %>
        <small class="muted"><%= course.level %></small>
      <% } %>
    </div>
  </div>
</a>
