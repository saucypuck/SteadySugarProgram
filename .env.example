# Copy to .env for local overrides (optional — app runs with none of these).
PORT=3000
SESSION_SECRET=change-me
# Postgres (Render sets this automatically from the blueprint). Omit to use in-memory store.
DATABASE_URL=
# Seed demo member/admin accounts + sample data. Turn OFF before launch.
SEED_DEMO=true
# Comma-separated emails that get admin access.
ADMIN_EMAILS=
# Integrations (not wired yet — see src/integrations/*)
STRIPE_SECRET_KEY=
