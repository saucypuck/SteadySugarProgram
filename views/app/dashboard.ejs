<%- include('../partials/header') %>

<div class="page-head">
  <div>
    <p class="eyebrow">Week <%= week %> of <%= c.brand.programWeeks %></p>
    <% const hr = Number(new Intl.DateTimeFormat('en-US', { hour: 'numeric', hourCycle: 'h23', timeZone: 'America/New_York' }).format(new Date())); %>
    <h1><%= hr < 12 ? 'Good morning' : hr < 17 ? 'Good afternoon' : 'Good evening' %>, <%= user.name.split(' ')[0] %></h1>
  </div>
  <a href="/app/log" class="btn btn-primary">+ Log a reading</a>
</div>

<!-- Program progress -->
<div class="card roadmap-mini">
  <% c.roadmap.forEach((r, i) => { %>
    <div class="rm-step <%= i < roadmapIndex ? 'done' : i === roadmapIndex ? 'current' : '' %>">
      <span class="dot"></span><strong><%= r.title %></strong><small>Weeks <%= r.weeks %></small>
    </div>
  <% }) %>
</div>

<div class="dash-grid">
  <!-- Next lesson: the #1 action -->
  <div class="card span-2 next-lesson">
    <p class="eyebrow">Up next</p>
    <% if (next && next.locked) { %>
      <h2><%= next.lesson.title %></h2>
      <p class="muted"><%= next.course.title %> · <%= next.lesson.minutes %> min</p>
      <p>You’ve finished your free lessons — well done. Unlock the rest of the program to keep your momentum.</p>
      <a href="/checkout?plan=core" class="btn btn-primary">Unlock all lessons — <%= money(c.plans.core.price) %>/mo</a>
    <% } else if (next) { %>
      <h2><%= next.lesson.title %></h2>
      <p class="muted"><%= next.course.title %> · <%= next.lesson.minutes %> min</p>
      <p><strong>This week’s action:</strong> <%= next.lesson.action %></p>
      <a href="/app/courses/<%= next.course.slug %>/<%= next.lesson.slug %>" class="btn btn-primary">Continue lesson →</a>
    <% } else { %>
      <h2>You’ve completed every lesson. </h2>
      <a href="/app/courses" class="btn btn-secondary">Review courses</a>
    <% } %>
    <div class="progress mt-2"><span style="width:<%= totals.total ? Math.round(totals.done / totals.total * 100) : 0 %>%"></span></div>
    <small class="muted"><%= totals.done %> of <%= totals.total %> lessons complete</small>
  </div>

  <!-- Blueprint: today's checklist (accountability front and center) -->
  <% if (blueprint && blueprint.state === 'active') { const b = blueprint; %>
    <div class="card">
      <div class="row-between"><p class="eyebrow mb-0"><%= b.course.title %> · Day <%= b.dayNumber %></p><span class="small muted"><%= b.streak %>-day streak</span></div>
      <ul class="checklist compact mt-1">
        <% b.bp.daily.forEach((t) => { const on = b.todayChecks.includes(t.id); %>
          <li><form method="post" action="/app/blueprint/check"><input type="hidden" name="task" value="<%= t.id %>"><input type="hidden" name="date" value="<%= sched.today() %>"><input type="hidden" name="back" value="dashboard"><button class="check-row <%= on ? 'on' : '' %>" aria-pressed="<%= on %>"><span class="box"><%= on ? '✓' : '' %></span><%= t.label %></button></form></li>
        <% }) %>
      </ul>
      <% if (b.checkinDue) { %><a href="/app/blueprint#checkin" class="btn btn-primary btn-sm mt-1">Weekly check-in due</a><% } else { %><a href="/app/blueprint" class="small">Open tracker →</a><% } %>
    </div>
  <% } %>

  <!-- Meal & Movement Plan -->
  <div class="card">
    <% if (program && program.state === 'active') { const t = program.today; %>
      <p class="eyebrow"><%= program.plan.name %> · Week <%= t.week %></p>
      <p class="mb-0"><strong><%= t.workout.rest ? 'Rest day' : (t.workout.walk ? '' : '') + t.workout.focus %></strong> <small class="muted"><%= t.workout.detail %></small></p>
      <p class="small mt-1 mb-0">Dinner: <%= t.meals.dinner %></p>
      <a href="/app/plans" class="small">Today’s full plan →</a>
    <% } else if (program && program.state === 'upcoming') { %>
      <p class="eyebrow">Your plan</p>
      <p><strong><%= program.plan.name %></strong> starts <%= sched.formatDate(program.startDate) %>.</p>
      <a href="/app/plans" class="small">Preview week 1 →</a>
    <% } else { %>
      <p class="eyebrow">Meal &amp; movement plan</p>
      <p class="small muted">Get a menu and workout routine matched to your food, time and fitness.</p>
      <a href="/app/plans/quiz" class="btn btn-secondary btn-sm">Find my plan (1 min)</a>
    <% } %>
  </div>

  <!-- Next call -->
  <div class="card">
    <p class="eyebrow">Next call</p>
    <% if (upcoming.length) { const b = upcoming[0]; %>
      <h3><%= sched.CALL_TYPES[b.type].name %></h3>
      <p><%= sched.formatDate(b.date) %> · <%= sched.formatTime(b.time) %> <%= c.brand.timezoneLabel %></p>
      <a href="<%= b.joinUrl || '#' %>" class="btn btn-secondary btn-sm">Join link</a>
    <% } else if (quota.allowed) { %>
      <p class="muted">No call booked. You have <%= quota.remaining %> call<%= quota.remaining === 1 ? '' : 's' %> left this month.</p>
      <a href="/app/calendar" class="btn btn-secondary btn-sm">Book a call</a>
    <% } else { %>
      <p class="muted">Get 2 coaching calls a month with Core — or talk to us free first.</p>
      <a href="/checkout?plan=core" class="btn btn-primary btn-sm">Upgrade to Core</a>
      <a href="/book-call" class="btn btn-ghost btn-sm">Free discovery call</a>
    <% } %>
  </div>

  <!-- Glucose trend -->
  <div class="card">
    <p class="eyebrow">Fasting glucose</p>
    <% if (latest && latest.fasting) { %>
      <div class="big-num"><%= latest.fasting %><small> mg/dL</small></div>
      <% if (fastingChange !== null) { %><p class="<%= fastingChange <= 0 ? 'good' : 'warn' %>"><%= fastingChange <= 0 ? 'Down' : 'Up' %> <%= Math.abs(fastingChange) %> mg/dL since you started</p><% } %>
      <% if (fastingSpark) { %><svg viewBox="0 0 280 60" class="spark"><polyline points="<%= fastingSpark %>" /></svg><% } %>
    <% } else { %>
      <p class="muted">Log your first reading to see your trend.</p>
    <% } %>
  </div>

  <!-- Quick log -->
  <form method="post" action="/app/log" class="card stack">
    <p class="eyebrow">Quick log</p>
    <input type="hidden" name="from" value="dashboard">
    <input type="hidden" name="date" value="<%= sched.isoDate(new Date()) %>">
    <div class="grid-2 tight">
      <div class="field"><label>Fasting</label><input name="fasting" type="number" inputmode="numeric" placeholder="mg/dL"></div>
      <div class="field"><label>Post-meal</label><input name="postMeal" type="number" inputmode="numeric" placeholder="mg/dL"></div>
    </div>
    <button class="btn btn-secondary btn-sm">Save</button>
  </form>

  <!-- Daily habits -->
  <div class="card">
    <div class="row-between"><p class="eyebrow mb-0">Today’s plan</p><a href="/app/schedule" class="small">Calendar →</a></div>
    <% if (!todays.length) { %><p class="muted small mt-1">Nothing scheduled today. <a href="/app/schedule#plan">Set up your plan</a>.</p><% } %>
    <ul class="today-list">
      <% todays.slice(0, 7).forEach((e) => { %>
        <li class="ev-<%= e.type %>"><span class="ev-time"><%= sched.formatTime(e.time) %></span><a href="<%= (e.url || '#').replace(/^https?:\/\/[^/]+/, '') %>"><%= e.icon %> <%= e.summary %></a></li>
      <% }) %>
    </ul>
    <% if (todays.length > 7) { %><a href="/app/schedule" class="small">+<%= todays.length - 7 %> more</a><% } %>
    <a href="/app/schedule#sync" class="btn btn-ghost btn-sm mt-1">Get reminders on my phone</a>
  </div>

  <% if (tier === 'free' && !isAdmin) { %>
    <div class="card span-2 upsell">
      <h3>Unlock the full Steady Sugar program</h3>
      <p class="muted">All <%= totals.total %> lessons, full meal &amp; workout plans, plus 2 coaching calls every month.</p>
      <a href="/checkout?plan=core" class="btn btn-primary">Upgrade to Core — <%= money(c.plans.core.price) %>/mo</a>
    </div>
  <% } else if (tier === 'core') { %>
    <div class="card span-2">
      <h3>Want fully hands-on support?</h3>
      <p class="muted">VIP 1:1 adds weekly 1:1 calls, a custom plan built with you, and weekly glucose data reviews.</p>
      <a href="/checkout?plan=vip" class="btn btn-secondary">Upgrade to VIP 1:1 — <%= money(c.plans.vip.price) %>/mo</a>
    </div>
  <% } %>

  <div class="card span-2 quick-links">
    <a href="/app/plans">My meal &amp; movement plan</a>
    <a href="/app/blueprint">My blueprint</a>
    <a href="/app/courses">All courses</a>
    <a href="mailto:<%= c.brand.supportEmail %>">Message my coach</a>
  </div>
</div>

<%- include('../partials/footer') %>
