<%- include('../partials/header') %>

<div class="page-head"><div><p class="eyebrow">Tracker</p><h1>Glucose & habits</h1></div></div>

<div class="log-grid">
  <form method="post" action="/app/log" class="card stack">
    <h3>New entry</h3>
    <div class="field"><label for="lg-date">Date</label><input id="lg-date" type="date" name="date" value="<%= today %>" max="<%= today %>"></div>
    <div class="grid-2 tight">
      <div class="field"><label for="lg-f">Fasting <small class="muted">mg/dL</small></label><input id="lg-f" type="number" inputmode="numeric" name="fasting"></div>
      <div class="field"><label for="lg-p">2h post-meal <small class="muted">mg/dL</small></label><input id="lg-p" type="number" inputmode="numeric" name="postMeal"></div>
      <div class="field"><label for="lg-w">Weight <small class="muted">lbs</small></label><input id="lg-w" type="number" step="0.1" inputmode="decimal" name="weight"></div>
      <div class="field"><label for="lg-s">Steps</label><input id="lg-s" type="number" inputmode="numeric" name="steps"></div>
    </div>
    <div class="field"><label for="lg-n">Notes</label><input id="lg-n" name="notes" placeholder="e.g. walked after dinner, pasta night"></div>
    <button class="btn btn-primary btn-block">Save entry</button>
    <p class="micro">📲 Coming soon: sync from Dexcom, Libre, Apple Health.</p>
  </form>

  <div class="stack">
    <div class="card">
      <div class="row-between"><h3>Fasting trend</h3><span class="legend"><i class="lg-target"></i> target &lt; 100</span></div>
      <% if (fastingSpark) { %><svg viewBox="0 0 600 120" class="spark big" preserveAspectRatio="none"><polyline points="<%= fastingSpark %>" /></svg><% } else { %><p class="muted">Add 2+ fasting readings to see your trend.</p><% } %>
    </div>
    <div class="card">
      <h3>Post-meal trend</h3>
      <% if (postSpark) { %><svg viewBox="0 0 600 120" class="spark big alt" preserveAspectRatio="none"><polyline points="<%= postSpark %>" /></svg><% } else { %><p class="muted">Add 2+ post-meal readings to see your trend.</p><% } %>
    </div>
  </div>
</div>

<div class="table-wrap mt-2">
  <table class="table">
    <thead><tr><th>Date</th><th>Fasting</th><th>Post-meal</th><th>Weight</th><th>Steps</th><th>Notes</th></tr></thead>
    <tbody>
      <% if (!logs.length) { %><tr><td colspan="6" class="muted">No entries yet.</td></tr><% } %>
      <% logs.forEach((l) => { %>
        <tr>
          <td><%= sched.formatDate(l.date) %></td>
          <td class="<%= l.fasting && l.fasting < 100 ? 'good' : '' %>"><%= l.fasting ?? '—' %></td>
          <td class="<%= l.postMeal && l.postMeal < 140 ? 'good' : '' %>"><%= l.postMeal ?? '—' %></td>
          <td><%= l.weight ?? '—' %></td>
          <td><%= l.steps ? Number(l.steps).toLocaleString() : '—' %></td>
          <td class="muted"><%= l.notes %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('../partials/footer') %>
