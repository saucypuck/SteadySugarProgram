<%- include('../partials/header') %>

<!-- Hero: one clear promise, one primary action, reassurance underneath -->
<section class="hero">
  <div class="container hero-grid">
    <div>
      <p class="eyebrow">Coach-led program for prediabetes and type 2 diabetes</p>
      <h1>Steadier blood sugar, built on habits you can keep.</h1>
      <p class="lead">A structured, 12-week program of practical food, movement and daily routines — guided by credentialed coaches and designed to work alongside your doctor.</p>
      <div class="cta-row">
        <a href="/quiz" class="btn btn-primary btn-lg">Take the free 2-minute assessment</a>
        <a href="/signup" class="btn btn-secondary btn-lg">Create a free account</a>
      </div>
      <p class="micro">No credit card required. Prefer to talk first? <a href="/book-call">Schedule a free call</a>.</p>
    </div>
    <div class="hero-visual">
      <div class="wire wire-tall">Photograph: coach with a client (real, consented image)<br><small>Avoid stock imagery — authentic photos build trust</small></div>
      <div class="float-card">
        <small class="muted">Program content reviewed by</small>
        <strong><%= c.brand.reviewer %></strong>
        <small class="muted">Last reviewed <%= c.brand.lastReviewed %></small>
      </div>
    </div>
  </div>
</section>

<!-- Credibility at a glance -->
<section class="proof-bar">
  <div class="container credential-bar">
    <span><%- icon('shield') %> Evidence-based content</span>
    <span><%- icon('stethoscope') %> Reviewed by <%= c.brand.reviewer %></span>
    <span><%- icon('users') %> [500+] members coached</span>
    <span><%- icon('lock') %> Private and secure</span>
  </div>
</section>

<!-- The problem, in the reader's words -->
<section class="section">
  <div class="container narrow">
    <p class="eyebrow">Does this sound familiar?</p>
    <h2>Your doctor said “watch your sugar,” but didn’t give you a plan.</h2>
    <ul class="pain-list mt-2">
      <li>You feel tired in the afternoon and reach for something sweet to get through.</li>
      <li>Evening cravings undo a day of careful eating.</li>
      <li>Diet advice is conflicting, extreme, and hard to keep up.</li>
      <li>Your A1C has been creeping up and you’re not sure what will actually help.</li>
    </ul>
  </div>
</section>

<!-- How it works -->
<section class="section section-soft" id="how">
  <div class="container">
    <div class="center narrow">
      <p class="eyebrow">How it works</p>
      <h2>A clear, step-by-step path</h2>
    </div>
    <div class="grid-3 mt-3 steps">
      <div class="step"><span class="num">1</span><h3>Take the assessment</h3><p>Two minutes. We identify your blood sugar pattern and recommend the right level of support.</p></div>
      <div class="step"><span class="num">2</span><h3>Start with a plan</h3><p>Begin free, or follow a full meal and movement plan with coaching calls — at a pace that fits your life.</p></div>
      <div class="step"><span class="num">3</span><h3>Follow the roadmap</h3><p>Short weekly lessons, daily action steps and check-ins. Track your readings as they improve.</p></div>
    </div>
    <div class="center mt-3"><a href="/quiz" class="btn btn-primary btn-lg">Start the free assessment</a></div>
  </div>
</section>

<!-- What's included -->
<section class="section">
  <div class="container">
    <div class="center narrow">
      <p class="eyebrow">What’s included</p>
      <h2>Education, a plan, and people to keep you on track</h2>
    </div>
    <div class="grid-3 mt-3">
      <div class="card feature"><%- icon('book') %><h3>Video lessons</h3><p>Short lessons that explain what’s happening in your body — each with one clear action step.</p></div>
      <div class="card feature"><%- icon('utensils') %><h3>Meal &amp; movement plans</h3><p>Weekly menus and matching workouts, chosen for your food preferences, schedule and fitness.</p></div>
      <div class="card feature"><%- icon('clipboard') %><h3>Blueprints</h3><p>Two- to four-week action plans with a daily checklist and weekly check-ins, so changes stick.</p></div>
      <div class="card feature"><%- icon('phone') %><h3>Coaching calls</h3><p>Review your numbers with a credentialed coach and adjust your plan as you go.</p></div>
      <div class="card feature"><%- icon('chart') %><h3>Glucose tracker</h3><p>Log fasting and after-meal readings and see your progress over time.</p></div>
      <div class="card feature"><%- icon('calendar') %><h3>Calendar reminders</h3><p>Your lessons, meals and workouts appear in your phone’s calendar — no need to log in each day.</p></div>
    </div>
  </div>
</section>

<!-- Clinical standards -->
<section class="section section-soft" id="standards">
  <div class="container">
    <div class="center narrow">
      <p class="eyebrow">How our content is made</p>
      <h2>Information you can trust</h2>
    </div>
    <div class="standards mt-3">
      <div class="standard"><%- icon('shield') %><h3>Evidence-based</h3><p>Program content is based on <%= c.brand.guidelines %> and peer-reviewed research. Sources are listed with each course.</p></div>
      <div class="standard"><%- icon('stethoscope') %><h3>Professionally reviewed</h3><p>Every lesson and plan is reviewed by <%= c.brand.reviewer %> and updated as guidance changes.</p></div>
      <div class="standard"><%- icon('users') %><h3>Works with your doctor</h3><p>We provide education and lifestyle coaching — never diagnosis or medication advice. We encourage you to share your progress with your healthcare team.</p></div>
    </div>
    <p class="center small muted mt-2">Last reviewed <%= c.brand.lastReviewed %> · <a href="/legal/disclaimer">Medical disclaimer</a></p>
  </div>
</section>

<!-- Lead magnet -->
<section class="band">
  <div class="container band-grid">
    <div>
      <p class="eyebrow light">Free guide</p>
      <h2>The 7-Day Steady Sugar Meal Guide</h2>
      <p>A week of balanced breakfasts, lunches and dinners, plus a printable grocery list.</p>
    </div>
    <form method="post" action="/free-guide" class="inline-form">
      <label for="g-email" class="sr-only">Email address</label>
      <input id="g-email" type="email" name="email" placeholder="Your email address" required>
      <button class="btn btn-secondary">Email me the guide</button>
    </form>
  </div>
</section>

<!-- Roadmap -->
<section class="section">
  <div class="container">
    <div class="center narrow">
      <p class="eyebrow">The 12-week roadmap</p>
      <h2>Small changes, in the right order</h2>
    </div>
    <ol class="roadmap mt-3">
      <% c.roadmap.forEach((r) => { %>
        <li><span class="wk">Weeks <%= r.weeks %></span><h3><%= r.title %></h3><p><%= r.body %></p></li>
      <% }) %>
    </ol>
  </div>
</section>

<!-- Member stories -->
<section class="section section-soft">
  <div class="container">
    <div class="center narrow">
      <p class="eyebrow">Member stories</p>
      <h2>In their own words</h2>
      <p class="muted small">[Placeholders — replace with real stories shared with written permission.] Individual results vary.</p>
    </div>
    <div class="grid-3 mt-3">
      <% c.testimonials.forEach((t) => { %>
        <figure class="card quote">
          <blockquote>“<%= t.quote %>”</blockquote>
          <figcaption><div class="avatar"></div><div><strong><%= t.name %></strong><small><%= t.meta %></small></div></figcaption>
        </figure>
      <% }) %>
    </div>
  </div>
</section>

<!-- Coach -->
<section class="section">
  <div class="container grid-2 align-center">
    <div class="wire wire-square">Professional headshot</div>
    <div>
      <p class="eyebrow">Your coach</p>
      <h2><%= c.brand.coach %></h2>
      <p class="muted"><%= c.brand.coachTitle %></p>
      <p>[Two to three sentences in the first person: your training, who you’ve helped, and why you focus on blood sugar. Mention licenses and certifications by name.]</p>
      <a href="/about" class="btn btn-secondary">Meet our team</a>
    </div>
  </div>
</section>

<!-- Pricing -->
<section class="section section-soft" id="pricing">
  <div class="container">
    <div class="center narrow">
      <p class="eyebrow">Plans</p>
      <h2>Start free. Upgrade when you’re ready.</h2>
    </div>
    <div class="mt-3"><%- include('../partials/pricing-cards') %></div>
  </div>
</section>

<!-- Guarantee -->
<section class="section">
  <div class="container narrow">
    <div class="guarantee">
      <div class="seal"><%- icon('shield') %></div>
      <div><h3><%= c.guarantee.title %></h3><p><%= c.guarantee.body %></p></div>
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="section section-soft">
  <div class="container narrow">
    <h2 class="center">Common questions</h2>
    <div class="faq mt-2">
      <% c.faqs.forEach((f) => { %>
        <details><summary><%= f.q %></summary><p><%= f.a %></p></details>
      <% }) %>
    </div>
  </div>
</section>

<!-- Final CTA -->
<section class="section final-cta">
  <div class="container narrow center">
    <h2>Find out what’s driving your numbers.</h2>
    <p class="lead">The free assessment takes about two minutes and gives you a personalized starting plan.</p>
    <a href="/quiz" class="btn btn-primary btn-lg">Take the free assessment</a>
    <p class="micro">* Statistics shown in brackets are placeholders. Replace with verified outcomes before launch.</p>
  </div>
</section>

<div class="sticky-cta"><a href="/quiz" class="btn btn-primary btn-block">Take the free 2-minute assessment</a></div>

<%- include('../partials/footer') %>
