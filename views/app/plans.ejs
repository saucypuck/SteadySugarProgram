<%- include('../partials/header') %>

<div class="page-head">
  <div><p class="eyebrow">Plans</p><h1><%= program && !browse ? 'My plan' : 'Meal & Movement Plans' %></h1></div>
  <div class="cta-row mt-0">
    <a href="/app/plans/quiz" class="btn btn-secondary btn-sm">🎯 Plan finder quiz</a>
    <% if (program && browse) { %><a href="/app/plans" class="btn btn-primary btn-sm">Back to my plan</a><% } %>
  </div>
</div>
<%- include('_plan-tabs') %>

<% if (program && !browse) { const p = program.plan; %>
  <!-- Active / upcoming plan -->
  <section class="prog-hero">
    <div>
      <span class="pill"><%= program.state === 'upcoming' ? 'Starts ' + sched.formatDate(program.startDate) : 'Week ' + program.today.week + ' of ' + p.weeks %></span>
      <h2 class="mt-1 mb-0"><%= p.name %></h2>
      <p class="muted mb-0"><%= sched.formatDate(program.startDate) %> – <%= sched.formatDate(program.endDate) %> · <%= program.state === 'upcoming' ? program.startsIn + ' day' + (program.startsIn === 1 ? '' : 's') + ' to go' : program.daysLeft + ' days left' %></p>
      <% if (program.pairedWith) { const [k, slug] = program.pairedWith.split(':'); const pc = c.courses.find((x) => x.slug === slug); if (pc) { %>
        <p class="small mt-1 mb-0">🔗 Paired with <a href="/app/courses/<%= pc.slug %>"><%= pc.title %></a> (<%= k === 'blueprint' ? 'blueprint' : 'course' %>)</p>
      <% } } %>
    </div>
    <div class="prog-progress">
      <% const pct = program.state === 'active' ? Math.round((program.today.dayNumber / (p.weeks * 7)) * 100) : 0; %>
      <div class="ring" style="--pct:<%= pct %>"><span><%= pct %>%</span></div>
      <small class="muted">through the plan</small>
    </div>
  </section>

  <% if (program.state === 'active') { const t = program.today; %>
    <div class="grid-2 mt-2">
      <section class="card">
        <p class="eyebrow">Today · Day <%= t.dayNumber %></p>
        <h3>🥗 What to eat</h3>
        <dl class="meal-dl">
          <dt>Breakfast</dt><dd><%= t.meals.breakfast %></dd>
          <dt>Lunch</dt><dd><%= t.meals.lunch %></dd>
          <dt>Dinner</dt><dd><%= t.meals.dinner %></dd>
          <dt>Snack</dt><dd><%= t.meals.snack %></dd>
        </dl>
      </section>
      <section class="card">
        <p class="eyebrow">Phase: <%= t.phase.title %></p>
        <h3><%= t.workout.rest ? '😌 Rest day' : (t.workout.walk ? '🚶 ' : '💪 ') + t.workout.focus %></h3>
        <p class="small muted"><%= t.workout.detail %></p>
        <% if (t.workout.moves) { %>
          <div class="table-wrap"><table class="traffic"><thead><tr><th>Exercise</th><th>Sets</th><th>Reps</th></tr></thead>
            <tbody><% t.workout.moves.forEach(([n, sets, reps]) => { %><tr><td><span class="demo-thumb">▶</span><%= n %></td><td><%= sets %></td><td><%= reps %></td></tr><% }) %></tbody></table></div>
        <% } %>
        <p class="small mt-1 mb-0"><strong>This phase:</strong> <%= t.phase.focus %></p>
      </section>
    </div>
  <% } %>

  <section class="mt-2">
    <h2 class="h3"><%= program.state === 'upcoming' ? 'Your first week' : 'Next 7 days' %></h2>
    <div class="table-wrap card p-0">
      <table class="table meal-table plan-week">
        <thead><tr><th>Day</th><th>Breakfast</th><th>Lunch</th><th>Dinner</th><th>Snack</th><th>Movement</th></tr></thead>
        <tbody>
          <% week.forEach((d) => { %>
            <tr class="<%= d.isToday ? 'is-today' : '' %>">
              <th data-label="Day"><%= d.label %><br><small>Day <%= d.dayNumber %></small></th>
              <td data-label="Breakfast"><%= d.meals.breakfast %></td><td data-label="Lunch"><%= d.meals.lunch %></td><td data-label="Dinner"><%= d.meals.dinner %></td><td data-label="Snack"><%= d.meals.snack %></td>
              <td data-label="Movement"><strong><%= d.workout.focus %></strong><br><small class="muted"><%= d.workout.detail %></small></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>

  <div class="grid-2 mt-2">
    <section class="card">
      <h3>🛒 Grocery list</h3>
      <div class="grocery-cols">
        <% Object.entries(p.grocery).forEach(([g, items]) => { %><div><strong><%= g %></strong><ul class="grocery"><% items.forEach((i) => { %><li><label><input type="checkbox"> <%= i %></label></li><% }) %></ul></div><% }) %>
      </div>
      <button class="btn btn-ghost btn-sm" onclick="window.print()">Print week + list</button>
    </section>
    <section class="card">
      <h3>🎯 Daily targets</h3>
      <div class="target-row"><% p.targets.forEach((tg) => { %><div class="target"><small class="muted"><%= tg.label %></small><strong><%= tg.value %></strong></div><% }) %></div>
      <h3 class="mt-2">Phases</h3>
      <ol class="phase-list">
        <% p.phases.forEach((ph) => { const cur = program.state === 'active' && program.today.week >= ph.weeks[0] && program.today.week <= ph.weeks[1]; %>
          <li class="<%= cur ? 'current' : '' %>"><strong>Weeks <%= ph.weeks[0] %>–<%= ph.weeks[1] %>: <%= ph.title %></strong><span><%= ph.focus %></span></li>
        <% }) %>
      </ol>
    </section>
  </div>

  <div class="cta-row mt-2">
    <a href="/app/schedule" class="btn btn-secondary btn-sm">📅 See it on my calendar</a>
    <a href="/app/plans?browse=1" class="btn btn-ghost btn-sm">Browse other plans</a>
    <form method="post" action="/app/plans/end" data-confirm="End <%= p.name %> now? It will be removed from your calendar."><button class="btn btn-ghost btn-sm danger">End plan</button></form>
  </div>

<% } else { %>
  <!-- Catalog -->
  <section class="finder-banner">
    <div>
      <h2 class="h3 mb-0">Not sure which plan fits?</h2>
      <p class="muted mb-0">Answer 7 quick questions about your food, schedule and fitness — we’ll match you to a plan and suggest a course and blueprint to pair with it.</p>
    </div>
    <a href="/app/plans/quiz" class="btn btn-primary">Take the plan finder →</a>
  </section>
  <% if (!full) { %>
    <div class="card upsell mt-2"><div class="row-between wrap"><div><strong>Plans are included with Core.</strong> <span class="muted">Browse them and try the finder free — enroll when you upgrade.</span></div><a href="/checkout?plan=core" class="btn btn-primary btn-sm">Upgrade — <%= money(c.plans.core.price) %>/mo</a></div></div>
  <% } %>
  <p class="small muted mt-2">Each plan pairs a weekly menu with a matching movement routine. You follow one plan at a time, with a set start and end date.</p>
  <div class="plan-grid-cards">
    <% plans.forEach((p) => { %><%- include('_plan-card', { p, badge: recommendedId === p.id ? 'Your match' : (program && program.planId === p.id ? 'Current plan' : null), why: null }) %><% }) %>
  </div>
  <% if (history.length) { %>
    <details class="archived mt-2"><summary>Past plans (<%= history.length %>)</summary>
      <ul class="archived-list"><% history.slice().reverse().forEach((hh) => { const hp = (plans.find((x) => x.id === hh.planId) || { name: hh.planId }); %><li><span><strong><%= hp.name %></strong> <small class="muted"><%= hh.startDate %> → <%= hh.endedAt || hh.endDate %></small></span><span class="status s-<%= hh.status === 'completed' ? 'winner' : 'ended' %>"><%= hh.status %></span></li><% }) %></ul>
    </details>
  <% } %>
<% } %>

<%- include('../partials/footer') %>
