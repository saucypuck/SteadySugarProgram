<%- include('../partials/header') %>
<% const need = c.plans[course.tier]; %>
<div class="card upsell narrow-card center">
  <div class="big-emoji">🔒</div>
  <p class="eyebrow"><%= course.title %></p>
  <h1><%= lesson ? lesson.title : course.title %></h1>
  <p class="lead"><%= lesson ? 'This lesson is part of the ' + need.name + '.' : course.summary %></p>
  <ul class="check-list left">
    <% need.features.forEach((f) => { %><li><%= f %></li><% }) %>
  </ul>
  <% if (need.applyFirst) { %>
    <a href="/book-call?plan=<%= need.id %>" class="btn btn-primary btn-lg">Apply for <%= need.name %> — book a free call</a>
    <p class="mt-1 small"><a href="/checkout?plan=<%= need.id %>">or enroll now — <%= money(need.price) %>/mo</a></p>
  <% } else { %>
    <a href="/checkout?plan=<%= need.id %>" class="btn btn-primary btn-lg">Unlock with <%= need.name %> — <%= money(need.price) %>/mo</a>
  <% } %>
  <p class="mt-1"><a href="/app/courses">Back to courses</a></p>
</div>
<%- include('../partials/footer') %>
