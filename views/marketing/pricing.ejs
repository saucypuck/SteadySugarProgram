<%- include('../partials/header') %>

<section class="section">
  <div class="container">
    <div class="center narrow">
      <p class="eyebrow">Pricing</p>
      <h1>Pick your level of support</h1>
      <p class="lead">Start free and explore. Upgrade to unlock the full program and coaching calls — or go all-in with hands-on 1:1 coaching.</p>
    </div>
    <div class="mt-3"><%- include('../partials/pricing-cards') %></div>
  </div>
</section>

<section class="section section-soft">
  <div class="container narrow">
    <h2 class="center">Compare plans</h2>
    <div class="table-wrap mt-2">
      <table class="table compare">
        <thead><tr><th></th><% Object.values(c.plans).forEach((p) => { %><th><%= p.name %></th><% }) %></tr></thead>
        <tbody>
          <tr><td>Blood Sugar Profile quiz</td><td>✓</td><td>✓</td><td>✓</td></tr>
          <tr><td>Glucose & habit tracker</td><td>✓</td><td>✓</td><td>✓</td></tr>
          <tr><td>Course library</td><td>4 preview lessons</td><td>✓ 8 courses</td><td>✓ 9 courses (incl. CGM Deep Dive)</td></tr>
          <tr><td>Meal &amp; movement plans</td><td>Plan finder + sample day</td><td>✓ All 5 plans</td><td>✓ Customized with your coach</td></tr>
          <tr><td>Blueprints (daily tasks + check-ins)</td><td>—</td><td>✓</td><td>✓ Coach-reviewed weekly</td></tr>
          <tr><td>Coaching calls / month</td><td>—</td><td>2 × 30 min</td><td>Weekly 1:1</td></tr>
          <tr><td>Kickoff & personalized plan</td><td>—</td><td>—</td><td>✓</td></tr>
          <tr><td>CGM data review</td><td>—</td><td>—</td><td>✓ Weekly</td></tr>
          <tr><td>Direct coach messaging</td><td>—</td><td>—</td><td>✓</td></tr>
          <tr><td>CGM Deep Dive course</td><td>—</td><td>—</td><td>✓</td></tr>
          <tr><td>Price</td><% Object.values(c.plans).forEach((p) => { %><td><strong><%= p.price ? money(p.price) + '/mo' : 'Free' %></strong></td><% }) %></tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

<section class="section">
  <div class="container narrow">
    <div class="guarantee">
      <div class="seal">30<br><small>DAY</small></div>
      <div><h3><%= c.guarantee.title %></h3><p><%= c.guarantee.body %></p></div>
    </div>
    <div class="faq mt-3">
      <% c.faqs.forEach((f) => { %><details><summary><%= f.q %></summary><p><%= f.a %></p></details><% }) %>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
