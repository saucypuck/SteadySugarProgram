<%- include('../partials/header') %>

<div class="page-head"><div><p class="eyebrow">Plans · Week <%= week %></p><h1>This week’s workouts</h1></div></div>
<%- include('plans-tabs') %>

<div class="grid-3">
  <% plan.phases.forEach((p) => { const [a, b] = p.weeks.split('–').map(Number); const cur = week >= a && week <= b; %>
    <div class="card <%= cur ? 'current-phase' : '' %>">
      <span class="badge"><%= cur ? 'You are here · ' : '' %>Weeks <%= p.weeks %></span>
      <h3 class="mt-1"><%= p.title %></h3>
      <p class="muted small"><%= p.body %></p>
    </div>
  <% }) %>
</div>

<h2 class="mt-3">Weekly schedule</h2>
<div class="week-strip">
  <% plan.week.forEach((d) => { %>
    <div class="card day-card <%= d.focus === 'Rest' ? 'rest' : '' %>">
      <small class="muted"><%= d.day %></small>
      <strong><%= d.focus %></strong>
      <small><%= d.detail %></small>
    </div>
  <% }) %>
</div>

<div class="grid-2 mt-3">
  <% Object.entries(plan.workouts).forEach(([name, list]) => { %>
    <div class="card">
      <h3><%= name %> <small class="muted">~25 min</small></h3>
      <table class="table">
        <thead><tr><th>Exercise</th><th>Sets</th><th>Reps</th></tr></thead>
        <tbody><% list.forEach((e) => { %><tr><td><span class="demo-thumb">▶</span><%= e.name %></td><td><%= e.sets %></td><td><%= e.reps %></td></tr><% }) %></tbody>
      </table>
    </div>
  <% }) %>
</div>
<p class="fine">Check with your doctor before starting a new exercise program. If you take insulin or sulfonylureas, check your blood sugar before and after exercise.</p>

<%- include('../partials/footer') %>
