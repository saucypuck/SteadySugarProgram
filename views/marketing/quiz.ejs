<%- include('../partials/header') %>

<section class="quiz-wrap">
  <div class="container quiz-container">
    <div class="quiz-progress" aria-hidden="true"><span data-quiz-bar></span></div>
    <p class="muted small center" data-quiz-count>Blood Sugar Profile Quiz</p>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <form method="post" action="/quiz" class="quiz" data-quiz>
      <% c.quiz.forEach((q, i) => { %>
        <fieldset class="quiz-step" data-step>
          <legend><span class="q-num">Question <%= i + 1 %> of <%= c.quiz.length %></span><%= q.question %></legend>
          <div class="options">
            <% q.options.forEach((o) => { %>
              <label class="option">
                <input type="radio" name="<%= q.id %>" value="<%= o.value %>" required>
                <span><%= o.label %></span>
              </label>
            <% }) %>
          </div>
        </fieldset>
      <% }) %>

      <fieldset class="quiz-step" data-step>
        <legend><span class="q-num">Last step</span>Where should we send your results?</legend>
        <p class="muted">You’ll see your profile instantly on the next screen. We’ll also email you a copy plus your free meal guide.</p>
        <div class="field"><label for="q-name">First name</label><input id="q-name" name="name" autocomplete="given-name" required></div>
        <div class="field"><label for="q-email">Email</label><input id="q-email" type="email" name="email" autocomplete="email" required></div>
        <label class="check"><input type="checkbox" name="consent" required> I agree to receive emails from <%= c.brand.name %>. Unsubscribe anytime.</label>
        <button class="btn btn-primary btn-lg btn-block mt-2">See my results →</button>
        <p class="micro center">🔒 We never sell your data.</p>
      </fieldset>

      <div class="quiz-nav" data-quiz-nav>
        <button type="button" class="btn btn-ghost" data-quiz-back>← Back</button>
        <button type="button" class="btn btn-secondary" data-quiz-next>Next →</button>
      </div>
    </form>
  </div>
</section>

<%- include('../partials/footer') %>
