<%- include('../partials/header') %>

<section class="section">
  <div class="container">
    <div class="center narrow">
      <p class="eyebrow">Pricing</p>
      <h1>Pick your level of support</h1>
      <p class="lead">Every plan includes the full 12-week course, meal plans, workout plans and tracker. Coaching is what changes.</p>
    </div>
    <div class="mt-3"><%- include('../partials/pricing-cards') %></div>
  </div>
</section>

<section class="section section-soft">
  <div class="container narrow">
    <h2 class="center">Compare plans</h2>
    <div class="table-wrap mt-2">
      <table class="table compare">
        <thead><tr><th></th><% Object.values(c.plans).forEach((p) => { %><th><%= p.name %></th><% }) %></tr></thead>
        <tbody>
          <tr><td>12-week course</td><td>✓</td><td>✓</td><td>✓</td></tr>
          <tr><td>Meal & workout plans</td><td>✓</td><td>✓</td><td>✓</td></tr>
          <tr><td>Glucose & habit tracker</td><td>✓</td><td>✓</td><td>✓</td></tr>
          <tr><td>Kickoff call</td><td>—</td><td>✓</td><td>✓</td></tr>
          <tr><td>Coaching calls / month</td><% Object.values(c.plans).forEach((p) => { %><td><%= p.callsPerMonth || '—' %></td><% }) %></tr>
          <tr><td>CGM data review</td><td>—</td><td>—</td><td>✓</td></tr>
          <tr><td>CGM Deep Dive course</td><td>—</td><td>—</td><td>✓</td></tr>
          <tr><td>Price</td><% Object.values(c.plans).forEach((p) => { %><td><strong><%= money(p.price) %></strong>/mo</td><% }) %></tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

<section class="section">
  <div class="container narrow">
    <div class="guarantee">
      <div class="seal">30<br><small>DAY</small></div>
      <div><h3><%= c.guarantee.title %></h3><p><%= c.guarantee.body %></p></div>
    </div>
    <div class="faq mt-3">
      <% c.faqs.forEach((f) => { %><details><summary><%= f.q %></summary><p><%= f.a %></p></details><% }) %>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
