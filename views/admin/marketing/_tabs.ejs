<div class="page-head">
  <div><p class="eyebrow">Marketing</p><h1><%= title %></h1></div>
  <div class="head-actions">
    <% if (locals.r) { %>
      <form method="get" class="range-form">
        <select name="range" onchange="this.form.submit()" aria-label="Date range">
          <% Object.entries(ranges).forEach(([k, v]) => { %><option value="<%= k %>" <%= r.range === k ? 'selected' : '' %>><%= v %></option><% }) %>
        </select>
      </form>
    <% } %>
  </div>
</div>
<nav class="tabs tabs-wide" aria-label="Marketing sections">
  <% const q = locals.r ? '?range=' + r.range : ''; %>
  <% [['overview', '/admin/marketing', 'Dashboard'], ['ads', '/admin/marketing/ads', 'Campaigns & ads'], ['experiments', '/admin/marketing/experiments', 'A/B tests']].forEach(([id, href, label]) => { %>
    <a href="<%= href + q %>" class="<%= tab === id ? 'active' : '' %>" <%- tab === id ? 'aria-current="page"' : '' %>><%= label %></a>
  <% }) %>
</nav>
