<%- include('../partials/header') %>

<section class="section">
  <div class="container booking-grid">
    <div>
      <p class="eyebrow">Free · 20 minutes · Video call</p>
      <% if (interest === 'vip') { %>
        <h1>Apply for VIP 1:1 coaching</h1>
        <p class="lead">VIP is hands-on and fully personalized, so we start with a free call to make sure it’s the right fit — and to map out your plan.</p>
      <% } else { %>
        <h1>Book your free discovery call</h1>
        <p class="lead">We’ll review your numbers and goals, and map out what your first 30 days could look like. If it’s not a fit, you’ll still leave with a plan.</p>
      <% } %>
      <ul class="check-list">
        <li>Understand what’s driving your readings</li>
        <li>Get 2–3 changes to start this week</li>
        <li>See if coaching is right for you</li>
      </ul>
      <div class="coach-mini"><div class="avatar lg"></div><div><strong><%= c.brand.coach %></strong><small class="muted"><%= c.brand.coachTitle %></small></div></div>
    </div>

    <form method="post" action="/book-call" class="card stack">
      <input type="hidden" name="interest" value="<%= interest || '' %>">
      <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
      <h3>1. Pick a time</h3>
      <%- include('../partials/slot-picker', { days }) %>
      <h3 class="mt-2">2. Your details</h3>
      <div class="field"><label for="b-name">Name</label><input id="b-name" name="name" required value="<%= lead ? lead.name : (user ? user.name : '') %>"></div>
      <div class="field"><label for="b-email">Email</label><input id="b-email" type="email" name="email" required value="<%= lead ? lead.email : (user ? user.email : '') %>"></div>
      <div class="field"><label for="b-phone">Phone <small class="muted">(optional, for reminders)</small></label><input id="b-phone" type="tel" name="phone"></div>
      <div class="field"><label for="b-notes">What would make this call a win for you?</label><textarea id="b-notes" name="notes" rows="3"></textarea></div>
      <button class="btn btn-primary btn-lg btn-block">Confirm my free call</button>
    </form>
  </div>
</section>

<%- include('../partials/footer') %>
