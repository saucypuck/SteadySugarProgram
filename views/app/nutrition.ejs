<%- include('../partials/header') %>

<div class="page-head">
  <div><p class="eyebrow">Plans</p><h1>This week’s meal plan</h1></div>
  <button class="btn btn-secondary" onclick="window.print()">Print / PDF</button>
</div>
<%- include('plans-tabs') %>

<div class="target-row">
  <% plan.targets.forEach((t) => { %><div class="card target"><small class="muted"><%= t.label %></small><strong><%= t.value %></strong></div><% }) %>
</div>

<div class="card mt-2">
  <h3>The Steady Plate</h3>
  <div class="plate">
    <div class="plate-veg">½ Non-starchy veggies</div>
    <div class="plate-pro">¼ Protein</div>
    <div class="plate-carb">¼ Smart carbs</div>
  </div>
</div>

<div class="table-wrap mt-2">
  <table class="table meal-table">
    <thead><tr><th>Day</th><th>Breakfast</th><th>Lunch</th><th>Dinner</th><th>Snack</th></tr></thead>
    <tbody>
      <% plan.week.forEach((d) => { %>
        <tr><th data-label="Day"><%= d.day %></th><td data-label="Breakfast"><%= d.breakfast %></td><td data-label="Lunch"><%= d.lunch %></td><td data-label="Dinner"><%= d.dinner %></td><td data-label="Snack"><%= d.snack %></td></tr>
      <% }) %>
    </tbody>
  </table>
</div>

<div class="card mt-2">
  <h3>Grocery list</h3>
  <div class="grid-3">
    <% Object.entries(plan.grocery).forEach(([group, items]) => { %>
      <div><strong><%= group %></strong><ul class="grocery"><% items.forEach((i) => { %><li><label><input type="checkbox"> <%= i %></label></li><% }) %></ul></div>
    <% }) %>
  </div>
</div>

<% if (!user.recipeVault) { %>
  <div class="card upsell mt-2">
    <h3>Want more variety?</h3>
    <p class="muted"><%= c.orderBump.description %></p>
    <a href="#" class="btn btn-secondary">Get the Recipe Vault — <%= money(c.orderBump.price) %></a>
  </div>
<% } %>

<%- include('../partials/footer') %>
