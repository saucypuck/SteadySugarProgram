<%- include('../partials/header') %>

<% if (preview) { %>
  <div class="flash flash-info">Admin preview — views aren’t tracked. Status: <strong><%= page.status %></strong> · <a href="/admin/marketing/pages/<%= page.id %>/edit">Edit page</a></div>
<% } %>

<section class="hero">
  <div class="container hero-grid">
    <div>
      <% if (page.eyebrow) { %><p class="eyebrow"><%= page.eyebrow %></p><% } %>
      <h1><%= page.headline %></h1>
      <% if (page.subheadline) { %><p class="lead"><%= page.subheadline %></p><% } %>
      <% if (bullets.length) { %>
        <ul class="check-list"><% bullets.forEach((b) => { %><li><%= b %></li><% }) %></ul>
      <% } %>
      <div class="cta-row">
        <a href="<%= cta.href %>" class="btn btn-primary btn-lg"><%= cta.label %> →</a>
      </div>
      <p class="micro">Free to start · No credit card</p>
    </div>
    <div class="hero-visual">
      <div class="wire wire-tall">Hero image / video for “<%= page.name %>”</div>
    </div>
  </div>
</section>

<section class="proof-bar">
  <div class="container proof-row">
    <div><strong>[500+]</strong><span>clients coached</span></div>
    <div><strong>[0.6%]</strong><span>avg A1C drop*</span></div>
    <div><strong>[4.9★]</strong><span>client rating</span></div>
    <div><strong>[CDCES]</strong><span>certified coach</span></div>
  </div>
</section>

<section class="section section-soft">
  <div class="container">
    <div class="grid-3 steps">
      <div class="step"><span class="num">1</span><h3>Take the quiz</h3><p>Find your blood sugar pattern in 2 minutes.</p></div>
      <div class="step"><span class="num">2</span><h3>Start free</h3><p>Try the first lessons, tracker and a sample meal plan.</p></div>
      <div class="step"><span class="num">3</span><h3>Go further</h3><p>Unlock the full program and coaching when you’re ready.</p></div>
    </div>
  </div>
</section>

<% if (page.showTestimonials) { %>
  <section class="section">
    <div class="container grid-3">
      <% c.testimonials.forEach((t) => { %>
        <figure class="card quote"><div class="stars">★★★★★</div><blockquote>“<%= t.quote %>”</blockquote>
          <figcaption><div class="avatar"></div><div><strong><%= t.name %></strong><small><%= t.meta %></small></div></figcaption></figure>
      <% }) %>
    </div>
  </section>
<% } %>

<% if (page.showPricing) { %>
  <section class="section section-soft">
    <div class="container"><%- include('../partials/pricing-cards') %></div>
  </section>
<% } %>

<section class="section final-cta">
  <div class="container narrow center">
    <h2><%= page.headline %></h2>
    <a href="<%= cta.href %>" class="btn btn-primary btn-lg"><%= cta.label %> →</a>
  </div>
</section>

<div class="sticky-cta"><a href="<%= cta.href %>" class="btn btn-primary btn-block"><%= cta.label %> →</a></div>

<%- include('../partials/footer') %>
