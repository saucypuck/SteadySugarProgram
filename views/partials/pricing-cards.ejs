<%# Usage: include('partials/pricing-cards', { highlight: 'coaching', ctaPrefix: 'Start' }) %>
<div class="pricing-grid">
  <% Object.values(c.plans).forEach((p) => { const hl = (locals.highlight || 'coaching') === p.id; %>
    <div class="price-card <%= hl ? 'featured' : '' %>">
      <% if (hl) { %><span class="ribbon"><%= locals.highlight && locals.highlight !== 'coaching' ? 'Recommended for you' : 'Most popular' %></span><% } %>
      <h3><%= p.name %></h3>
      <p class="muted"><%= p.tagline %></p>
      <div class="price"><span class="amt"><%= money(p.price) %></span><span class="per">/<%= p.interval %></span></div>
      <ul class="check-list">
        <% p.features.forEach((f) => { %><li><%= f %></li><% }) %>
      </ul>
      <a href="/checkout?plan=<%= p.id %>" class="btn <%= hl ? 'btn-primary' : 'btn-secondary' %> btn-block">
        <%= (user && user.plan === p.id && user.status === 'active') ? 'Current plan' : `Choose ${p.name}` %>
      </a>
    </div>
  <% }) %>
</div>
<p class="center muted small mt-2">Cancel anytime · <%= c.guarantee.title %> · Not sure? <a href="/quiz">Take the 2-minute quiz</a> or <a href="/book-call">book a free call</a>.</p>
