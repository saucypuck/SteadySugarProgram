<%# Notes + follow-up tasks for a lead or member. Needs subjectType, subjectId, back, notes, tasks, today. %>
<section class="card">
  <h3>Follow-ups</h3>
  <ul class="task-list">
    <% if (!tasks.length) { %><li class="muted small">No tasks yet.</li><% } %>
    <% tasks.forEach((t) => { const late = !t.done && t.due && t.due < today; %>
      <li class="<%= t.done ? 'done' : '' %>">
        <form method="post" action="/admin/crm/tasks/<%= t.id %>/toggle">
          <input type="hidden" name="back" value="<%= back %>">
          <button class="tick-btn" aria-label="<%= t.done ? 'Mark not done' : 'Mark done' %>"><%= t.done ? '✓' : '' %></button>
        </form>
        <span class="task-title"><%= t.title %></span>
        <% if (t.due) { %><small class="<%= late ? 'tone-bad' : t.due === today ? 'tone-warn' : 'muted' %>"><%= late ? 'Overdue · ' : t.due === today ? 'Today · ' : '' %><%= sched.formatDate(t.due) %></small><% } %>
      </li>
    <% }) %>
  </ul>
  <form method="post" action="/admin/crm/tasks" class="inline-add">
    <input type="hidden" name="subjectType" value="<%= subjectType %>"><input type="hidden" name="subjectId" value="<%= subjectId %>"><input type="hidden" name="back" value="<%= back %>">
    <input name="title" placeholder="e.g. Check in after first coaching call" required aria-label="Task">
    <input type="date" name="due" value="<%= today %>" aria-label="Due date">
    <button class="btn btn-secondary btn-sm">Add task</button>
  </form>
</section>

<section class="card">
  <h3>Notes</h3>
  <form method="post" action="/admin/crm/notes" class="stack">
    <input type="hidden" name="subjectType" value="<%= subjectType %>"><input type="hidden" name="subjectId" value="<%= subjectId %>"><input type="hidden" name="back" value="<%= back %>">
    <textarea name="body" rows="2" placeholder="Call notes, preferences, context…" required aria-label="Note"></textarea>
    <button class="btn btn-secondary btn-sm">Add note</button>
  </form>
  <ul class="note-list">
    <% notes.slice().sort((a, b) => b.createdAt.localeCompare(a.createdAt)).forEach((n) => { %>
      <li><p><%= n.body %></p><small class="muted"><%= n.by %> · <%= new Date(n.createdAt).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) %></small></li>
    <% }) %>
  </ul>
</section>
