<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= locals.title ? title + ' · ' : '' %><%= c.brand.name %></title>
  <meta name="description" content="<%= c.brand.name %> — coach-led blood sugar program for prediabetes and type 2 diabetes. Simple food, movement and habit changes.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><circle cx='16' cy='16' r='15' fill='%230f766e'/><path d='M6 18c4 0 5-6 10-6s6 6 10 6' stroke='white' stroke-width='3' fill='none' stroke-linecap='round'/></svg>">
  <script>document.documentElement.classList.add('js')</script>
</head>
<body class="v-<%= variant %>">
<% if (demoMode) { %>
  <div class="demo-bar">Wireframe / demo mode — payments, email &amp; video calls are simulated.
    <% if (!user) { %><a href="/login">Demo logins</a><% } %>
  </div>
<% } %>

<% const brandMark = `<a href="/" class="logo"><svg width="28" height="28" viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="15" fill="currentColor"/><path d="M6 18c4 0 5-6 10-6s6 6 10 6" stroke="#fff" stroke-width="3" fill="none" stroke-linecap="round"/></svg><span>${c.brand.name}</span></a>`; %>

<% if (variant === 'app' || variant === 'admin') { %>
  <%
    const nav = variant === 'admin'
      ? [['/admin', 'Overview', '📊'], ['/app', 'Member view', '👤'], ['/', 'Public site', '🌐']]
      : [['/app', 'Home', '🏠'], ['/app/courses', 'Courses', '🎓'], ['/app/plans/nutrition', 'Plans', '🥗'], ['/app/log', 'Tracker', '📈'], ['/app/calendar', 'Calls', '📅'], ['/app/account', 'Account', '⚙️']];
    const active = (href) => href === path || (href !== '/app' && href !== '/admin' && href !== '/' && path.startsWith(href.split('/').slice(0, 3).join('/')));
  %>
  <div class="shell">
    <aside class="sidebar">
      <%- brandMark %>
      <nav class="side-nav">
        <% nav.forEach(([href, label, icon]) => { %>
          <a href="<%= href %>" class="<%= active(href) ? 'active' : '' %>"><span class="ico"><%= icon %></span><span><%= label %></span></a>
        <% }) %>
        <% if (variant === 'app' && tier === 'free' && !isAdmin) { %><a href="/pricing" class="side-upgrade"><span class="ico">⭐</span><span>Upgrade</span></a><% } %>
        <% if (isAdmin && variant === 'app') { %><a href="/admin"><span class="ico">📊</span><span>Admin</span></a><% } %>
      </nav>
      <div class="side-foot">
        <div class="who"><strong><%= user.name %></strong><small><%= isAdmin ? 'Admin' : c.plans[tier].name + (tier === 'free' ? ' account' : ' plan') %></small></div>
        <form method="post" action="/logout"><button class="btn btn-ghost btn-sm">Log out</button></form>
      </div>
    </aside>
    <main class="shell-main">
      <header class="shell-top">
        <%- brandMark %>
        <form method="post" action="/logout"><button class="btn btn-ghost btn-sm">Log out</button></form>
      </header>
<% } else { %>
  <header class="site-header">
    <div class="container nav-row">
      <%- brandMark %>
      <% if (variant !== 'minimal') { %>
        <button class="nav-toggle" aria-label="Menu" aria-expanded="false" data-nav-toggle>☰</button>
        <nav class="site-nav" data-nav>
          <a href="/program">How it works</a>
          <a href="/pricing">Pricing</a>
          <a href="/about">Coach</a>
          <a href="/free-guide">Free guide</a>
          <% if (user) { %>
            <a href="<%= isAdmin ? '/admin' : '/app' %>" class="btn btn-secondary btn-sm">My dashboard</a>
          <% } else { %>
            <a href="/login">Log in</a>
            <a href="/signup">Start free</a>
            <a href="/quiz" class="btn btn-primary btn-sm">Take the quiz</a>
          <% } %>
        </nav>
      <% } else { %>
        <nav class="site-nav-min">
          <% if (user) { %><a href="/app">Dashboard</a><% } else { %><a href="/login">Log in</a><% } %>
        </nav>
      <% } %>
    </div>
  </header>
  <main>
<% } %>

<% if (flash) { %>
  <div class="flash flash-<%= flash.type %>"><%= flash.msg %></div>
<% } %>
